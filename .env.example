PORT=3001
ADMIN_USERNAME=xiaotian
# Empty: generate a private random password in server/data/admin-secret.txt.
ADMIN_PASSWORD=
ALLOWED_ORIGINS=https://xiaotianaya.com,http://localhost:5173

# OpenAI-compatible chat completion endpoint used by Journal Studio.
# Leave these empty to disable AI suggestions without affecting visual editing or publishing.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
SITE_URL=https://xiaotianaya.com

# Optional fallback; Open Library is used without a key by default.
GOOGLE_BOOKS_API_KEY=
# Node >=24.5 can honour a deployment-provided proxy. Set these in the process
# environment BEFORE starting Node (not a hardcoded developer-machine address).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=https://your-proxy.example:port
# HTTP_PROXY=http://your-proxy.example:port
# NO_PROXY=localhost,127.0.0.1
